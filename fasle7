import math

# جذر (ریشه دوم)
x = math.sqrt(64)
print(x) # خروجی: 8.0

# گرد کردن به سمت بالا (سقف)
x = math.ceil(1.4)
print(x) # خروجی: 2

# گرد کردن به سمت پایین (کف)
x = math.floor(1.4)
print(x) # خروجی: 1
