#شماره ورودی
import math

x = input("Enter a number: ")

# تبدیل متن ورودی به عدد اعشاری برای محاسبه ریاضی
y = math.sqrt(float(x))

print(f"The square root of {x} is {y}")
#اعتبار سنجی ورودی
y = True
while y == True:
    x = input("Enter a number: ")
    try:
        x = float(x) # سعی می‌کند ورودی را به عدد تبدیل کند
        y = False    # اگر موفق شد، حلقه تمام می‌شود
    except:
        # اگر کاربر چیزی غیر از عدد وارد کند، این بخش اجرا می‌شود
        print("Wrong input, please try again.")

print("Thank you!")
#بلوک پایه
try:
    print(x) # چون x تعریف نشده، خطا رخ می‌دهد
except:
    print("An exception occurred")
#مدیریت خطا های خاص
try:
    print(x)
except NameError:
    print("Variable x is not defined")
except:
    print("Something else went wrong")
#استفاده از کلمه کلیدی else
try:
    print("Hello")
except:
    print("Something went wrong")
else:
    print("Nothing went wrong")
#استفاده از کلمه کلیدی finaly
try:
    print(x)
except:
    print("Something went wrong")
finally:
    print("The 'try except' is finished")
