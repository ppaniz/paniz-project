import math
import sympy as sp

# تعریف متغیر برای حل مشتق و انتگرال
x = sp.Symbol('x')

print("--- ماشین حساب مهندسی پانیذ ---")

# شروع برنامه با یک حلقه ساده
shart = True
while shart == True:
    print("\n1: عملیات اصلی (+-*/)")
    print("2: قدرمطلق و توان")
    print("3: مثلثات (سینوس کسینوس)")
    print("4: جذر")
    print("5: مشتق و انتگرال")
    print("6: خروج")
    
    entekhab = input("لطفا عدد گزینه را وارد کنید: ")

    try:
        if entekhab == '1':
            a = float(input("عدد اول: "))
            amal = input("عملگر را وارد کنید: ")
            b = float(input("عدد دوم: "))
            if amal == '+': print("جواب:", a + b)
            elif amal == '-': print("جواب:", a - b)
            elif amal == '*': print("جواب:", a * b)
            elif amal == '/': 
                if b != 0: print("جواب:", a / b)
                else: print("خطا: تقسیم بر صفر!")

        elif entekhab == '2':
            n = float(input("عدد: "))
            print("قدرمطلق:", abs(n))
            p = float(input("توان: "))
            print("نتیجه توان:", pow(n, p))

        elif entekhab == '3':
            deg = float(input("زاویه به درجه: "))
            rad = math.radians(deg)
            print("سینوس:", math.sin(rad))
            print("کسینوس:", math.cos(rad))

        elif entekhab == '4':
            adad = float(input("عدد برای جذر: "))
            if adad >= 0:
                print("جذر:", math.sqrt(adad))
            else:
                print("عدد منفی جذر ندارد")

        elif entekhab == '5':
            f = input("فرمول را بنویس (مثلا x**2): ")
            ebarat = sp.sympify(f)
            print("مشتق:", sp.diff(ebarat, x))
            print("انتگرال:", sp.integrate(ebarat, x))

        elif entekhab == '6':
            shart = False

    except:
        # اگر کاربر به جای عدد، متن وارد کنه این پیام میاد
        print("خطا! ورودی اشتباه است. لطفا دقت کنید.")

    finally:
        # این پیام همیشه در آخر هر مرحله چاپ میشه
        if shart == True:
            print("--- آماده برای محاسبه بعدی ---")
        else:
            print("برنامه با موفقیت بسته شد.")
