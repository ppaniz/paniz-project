import math
import sympy as sp

def get_float_input(prompt):
    """گرفتن عدد ایمن از کاربر با مدیریت خطا"""
    while True:
        user_input = input(prompt)
        try:
            return float(user_input)
        except:
            print("خطا: لطفاً فقط عدد وارد کنید!") #

def main():
    x = sp.Symbol('x')

    while True:
        print("\n--- ماشین حساب مهندسی فوق پیشرفته ---")
        print("1. محاسبات پایه (+ - * /)")
        print("2. قدر مطلق (abs)")
        print("3. مثلثات (sin, cos, tan)")
        print("4. جذر (sqrt)")
        print("5. مشتق (Derivative)")
        print("6. انتگرال (Integral)")
        print("7. خروج")

        choice = input("انتخاب شما: ")

        if choice == '1':
            a = get_float_input("عدد اول: ")
            op = input("عملگر (+ - * /): ")
            b = get_float_input("عدد دوم: ")
            if op == '+': print(f"نتیجه: {a + b}")
            elif op == '-': print(f"نتیجه: {a - b}")
            elif op == '*': print(f"نتیجه: {a * b}")
            elif op == '/': 
                if b != 0: print(f"نتیجه: {a / b}")
                else: print("خطا: تقسیم بر صفر!")

        elif choice == '2':
            n = get_float_input("عدد را وارد کنید: ")
            print(f"قدرمطلق {n} برابر است با: {abs(n)}") #

        elif choice == '3':
            angle = get_float_input("زاویه را به درجه وارد کنید: ")
            rad = math.radians(angle) # تبدیل درجه به رادیان
            print(f"sin({angle}) = {math.sin(rad)}")
            print(f"cos({angle}) = {math.cos(rad)}")
            print(f"tan({angle}) = {math.tan(rad)}")

        elif choice == '4':
            n = get_float_input("عدد را وارد کنید: ")
            if n >= 0: print(f"جذر: {math.sqrt(n)}") #
            else: print("خطا: عدد منفی جذر حقیقی ندارد!")

        elif choice == '5':
            expr_str = input("عبارت (مثلاً x**2 + sin(x)): ")
            try:
                expr = sp.sympify(expr_str)
                print(f"مشتق: {sp.diff(expr, x)}") #
            except: print("خطا در عبارت ریاضی!")

        elif choice == '6':
            expr_str = input("عبارت (مثلاً cos(x)): ")
            try:
                expr = sp.sympify(expr_str)
                print(f"انتگرال: {sp.integrate(expr, x)} + C") #
            except: print("خطا در عبارت ریاضی!")

        elif choice == '7':
            print("خداحافظ!")
            break
