import math
import sympy as sp

def get_float_input(prompt):
    """گرفتن عدد ایمن با مدیریت خطای NameError و موارد دیگر"""
    while True:
        user_input = input(prompt)
        try:
            return float(user_input)
        except ValueError: # خطای مربوط به تبدیل متن به عدد
            print("خطا: لطفاً فقط عدد وارد کنید!")
        except Exception as e: # مدیریت سایر خطاهای احتمالی
            print(f"یک خطای غیرمنتظره رخ داد: {e}")

def main():
    x = sp.Symbol('x')
    print("--- ماشین حساب مهندسی پانیذ راه اندازی شد ---")

    try: # شروع بلوک اصلی برای کل برنامه
        while True:
            print("\n--- منوی اصلی ---")
            print("1. پایه | 2. قدرمطلق | 3. مثلثات | 4. جذر | 5. مشتق | 6. انتگرال | 7. خروج")
            
            choice = input("انتخاب شما: ")

            if choice == '1':
                a = get_float_input("عدد اول: ")
                op = input("عملگر (+ - * /): ")
                b = get_float_input("عدد دوم: ")
                if op == '+': print(f"نتیجه: {a + b}")
                elif op == '/': 
                    if b != 0: print(f"نتیجه: {a / b}")
                    else: print("خطا: تقسیم بر صفر!")
                # سایر عملگرها به همین ترتیب...

            elif choice == '2':
                n = get_float_input("عدد: ")
                print(f"|{n}| = {abs(n)}")

            elif choice == '3':
                angle = get_float_input("زاویه به درجه: ")
                rad = math.radians(angle)
                print(f"sin: {math.sin(rad)}\ncos: {math.cos(rad)}")

            elif choice == '5':
                expr_str = input("عبارت (مثل x**2): ")
                try:
                    expr = sp.sympify(expr_str)
                    print(f"مشتق: {sp.diff(expr, x)}")
                except:
                    print("خطا: عبارت ریاضی نامعتبر است!")

            elif choice == '7':
                break
    
    finally:  
        print("\nبستن منابع برنامه...")
        print("عملیات با موفقیت به پایان رسید. (Try-Except-Finally Finished)")

if __name__ == "__main__":
    main()
